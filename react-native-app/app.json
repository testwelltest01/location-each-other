{
  "expo": {
    "name": "pickup-session-mobile",
    "slug": "pickup-session-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.pickup.session.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs location permission to show and share your position."
      }
    },
    "android": {
      "package": "com.pickup.session.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
